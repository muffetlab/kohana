# Copy this file to .env and adjust it for each environment.
# Real environment variables (from the web server or the shell) override these values.
# Every setting is read in config/*.php with env(); see docs/kohana/environment.md.

# production, staging, testing or development ("local" = development)
APP_ENV=development
# Path, and optionally the domain, the application is served from
APP_BASE_URL=/
# Front controller in URLs; leave empty when the web server rewrites URLs
APP_INDEX_FILE=index.php
APP_TIMEZONE=UTC
APP_LOCALE=en-us
# Comma separated host name patterns, e.g. example\.org,.*\.example\.org
APP_TRUSTED_HOSTS=
# Cache file lookups in production
APP_CACHING=false

# Encryption key and cookie salt: php kohana key:generate
APP_KEY=
COOKIE_SALT=
COOKIE_SECURE=false

# mysql, pgsql, PDO (with DB_DSN), or a driver class name
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kohana
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# native, cookie, database or redis
SESSION_DRIVER=native
SESSION_LIFETIME=0
# Redis driver: seconds an idle session is kept, and the cache store it uses
SESSION_TTL=7200
SESSION_STORE=redis

# file, apcu, redis, memcached or sqlite (cache module)
CACHE_STORE=file

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Only needed to verify passwords stored by Kohana 3 (see UPGRADE.md)
AUTH_HASH_KEY=
