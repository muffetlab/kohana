# Copy this file to .env and adjust it for each environment.
# Real environment variables (from the web server or the shell) override these values.

# production, staging, testing or development ("local" = development)
APP_ENV=development
# Path, and optionally the domain, the application is served from
APP_BASE_URL=/
# Encryption key and cookie salt: php public/index.php --task=key:generate
APP_KEY=
COOKIE_SALT=

# mysql, pgsql, PDO (with DB_DSN), or a driver class name
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kohana
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Only needed to verify passwords stored by Kohana 3 (see UPGRADE.md)
AUTH_HASH_KEY=
