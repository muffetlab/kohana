{
    "name": "muffetlab/kohana",
    "type": "project",
    "description": "The Kohana PHP framework",
    "keywords": [
        "framework",
        "kohana"
    ],
    "homepage": "https://kohana.top",
    "license": "MIT",
    "authors": [
        {
            "name": "Kohana Team",
            "homepage": "https://kohanaframework.org"
        },
        {
            "name": "Kohana Group",
            "homepage": "https://kohana.top/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "michelf/php-markdown": "^1.9"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "phpunit/phpunit-dom-assertions": "^3.8"
    },
    "suggest": {
        "ext-apcu": "For the APCu cache store",
        "ext-memcached": "For the Memcached cache store",
        "ext-redis": "For the Redis cache store",
        "ext-pdo_pgsql": "For the PostgreSQL database driver",
        "ext-imagick": "For the Imagick image driver"
    },
    "autoload": {
        "psr-4": {
            "Kohana\\": [
                "system/src",
                "modules/auth/src",
                "modules/cache/src",
                "modules/database/src",
                "modules/image/src",
                "modules/minion/src",
                "modules/orm/src",
                "modules/unittest/src"
            ],
            "App\\": "application/classes/"
        },
        "files": [
            "system/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/App/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-z3gr-8qht-p93v"
                ]
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
