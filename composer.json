{
    "name": "muffetlab/kohana",
    "type": "project",
    "description": "The Kohana PHP framework",
    "keywords": ["framework", "kohana"],
    "homepage": "https://kohana.top",
    "license": "MIT",
    "authors": [
        {
            "name": "Kohana Team",
            "homepage": "https://kohanaframework.org"
        },
        {
            "name": "Kohana Group",
            "homepage": "https://kohana.top/contributors"
        }
    ],
    "require": {
        "php": ">=7.1,<7.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "michelf/php-markdown": "^1.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5",
        "phpunit/phpunit-dom-assertions": "^2.6.0"
    },
    "autoload": {
        "psr-4": {
            "Kohana\\": [
                "system/classes/Kohana",
                "modules/auth/classes/Kohana",
                "modules/cache/classes/Kohana",
                "modules/codebench/classes",
                "modules/database/classes/Kohana",
                "modules/image/classes/Kohana",
                "modules/minion/classes/Kohana",
                "modules/orm/classes/Kohana",
                "modules/unittest/classes/Kohana",
                "modules/userguide/classes/Kohana"
            ],
            "App\\": "application/classes"
        },
        "files": [
            "system/functions.php"
        ]
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-z3gr-8qht-p93v"
                ]
            }
        }
    }
}
